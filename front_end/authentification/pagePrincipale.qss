/* Main Application Stylesheet */

/* Side Navigation Widget - Icon and Name Version */
QWidget#icon_name_widget, QWidget#icon_only_widget {
    background-color: rgb(60, 139, 238);
    color: white;
}

QWidget#icon_name_widget QPushButton, QWidget#icon_only_widget QPushButton {
    color: white;
    height: 30px;
    border: none;
    border-radius: 10px;
    text-align: left;
    padding-left: 10px;
}

QWidget#icon_name_widget QPushButton:checked, QWidget#icon_only_widget QPushButton:checked {
    background-color: #F5FAFE;
    color: #1F95EF;
    font-weight: bold;
}

/* Main Window */
QMainWindow {
    background-color: rgb(189, 247, 254);
}

/* Stacked Widget */
QStackedWidget {
    background-color: rgb(118, 132, 134);
}

/* Search Line Edit */
QLineEdit {
    padding: 5px;
    border: 1px solid #d0d0d0;
    border-radius: 5px;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #d0d0d0;
    background: white;
}

QTabBar::tab {
    background: #f0f0f0;
    border: 1px solid #d0d0d0;
    padding: 5px 10px;
    margin-right: 2px;
}

QTabBar::tab:selected {
    background: #1F95EF;
    color: white;
}

/* Buttons without specific styling */
QPushButton {
    border: none;
}

/* Labels */
QLabel {
    color: #333;
}

QLabel[title="appName"] {
    font-size: 16px;
    font-weight: bold;
    color: white;
}